model LiveSession {
  id                String   @id @default(cuid())
  title             String
  description       String?
  courseId          String?
  course            Course?  @relation(fields: [courseId], references: [id])
  instructorId      String
  instructor        User     @relation("InstructorSessions", fields: [instructorId], references: [id])
  type              String   @default("live_class") // live_class, office_hours, qa_session, workshop
  meetingUrl        String?
  meetingId         String? // external meeting ID (Zoom, Meet)
