model InstructorSettings {
  id                    String  @id @default(cuid())
  instructorId          String  @unique
  instructor            User    @relation(fields: [instructorId], references: [id])
  // Notification preferences
  notifyEnrollment      String  @default("in-app") // in-app, email, off
  notifyQA              String  @default("in-app")
  notifyReview          String  @default("in-app")
  notifyAssignment      String  @default("in-app")
  notifyMessage         String  @default("in-app")
  notifyCourseApproved  String  @default("in-app")
  notifyPayout          String  @default("in-app")
  notifyPromotion       String  @default("off")
  // Payout preferences
  payoutSchedule        String  @default("monthly") // monthly, on_request
  payoutThreshold       Int     @default(2000) // minimum PKR amount
  defaultPayoutMethodId String?
  // Integration settings
  integrations          String? // JSON: {zoom: {connected, apiKey}, meet: {connected}, mailchimp: {connected, apiKey}, zapier: {connected, webhookUrl}, webhooks: [{url, events}]}

  // Appearance & Preferences
  theme           String  @default("system") // light, dark, system
  compactMode     Boolean @default(false)
