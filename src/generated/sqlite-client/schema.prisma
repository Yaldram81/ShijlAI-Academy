  preferredLanguage String @default("en")

  // Email preferences
  emailDigest         String  @default("daily") // immediately, daily, weekly, off
  marketingEmails     Boolean @default(true)
  securityAlertEmails Boolean @default(true)
  courseUpdateEmails  Boolean @default(true)

  // Editor & Course preferences
  autoSaveDrafts        Boolean @default(true)
  defaultCourseLanguage String  @default("en")
  videoQuality          String  @default("1080p") // 720p, 1080p, 4k

