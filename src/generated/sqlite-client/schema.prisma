model LessonNote {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  content      String // note text
  timestamp    Int        @default(0) // video timestamp in seconds when note was taken
  color        String     @default("default") // note color: default, yellow, green, blue, pink, purple
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, lessonId, enrollmentId])
}

model LessonBookmark {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  timestamp    Int        @default(0) // video timestamp in seconds
  label        String? // optional label for the bookmark
  createdAt    DateTime   @default(now())

  @@index([userId, lessonId, enrollmentId])
}

model Skill {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique // "python-programming"
  category      String // Technical, Soft Skills, Tools
  description   String?
  icon          String? // emoji or icon name
  parentSkillId String? // for sub-skills (e.g., "Decorators" is sub-skill of "Python Programming")
  parentSkill   Skill?   @relation("SkillSubSkills", fields: [parentSkillId], references: [id])
  subSkills     Skill[]  @relation("SkillSubSkills")
  createdAt     DateTime @default(now())

  userSkills       UserSkill[]
  courseSkills     CourseSkill[]
  lessonSkills     LessonSkill[]
  questionSkills   QuestionSkill[]
  careerPathSkills CareerPathSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  // Component scores (0-100 each) — Skill Extraction Engine
  lessonScore      Float @default(0) // Avg watch% across lessons tagged with this skill (weight: 0.20)
  quizScore        Float @default(0) // Avg score on quiz questions tagged with this skill (weight: 0.35)
  assignmentScore  Float @default(0) // Avg rubric criteria score tagged with this skill (weight: 0.30)
  tutorSignalScore Float @default(0) // Inverted frequency: fewer Qs = higher confidence (weight: 0.10)
  certBonus        Float @default(0) // +100 if certificate earned in course containing this skill (weight: 0.05)

  // Final computed score
  overallScore Float  @default(0) // weighted: lesson*0.20 + quiz*0.35 + assign*0.30 + tutor*0.10 + cert*0.05
  level        String @default("awareness") // awareness, beginner, elementary, intermediate, advanced, expert

  // Metadata
  lastUpdated   DateTime  @default(now())
  lastPracticed DateTime  @default(now()) // for decay calculation
  evidenceCount Int       @default(0) // how many data points contribute
  isVerified    Boolean   @default(false) // certified via course completion
  verifiedBy    String? // course title that verified this skill
  verifiedAt    DateTime?

  xpEarned  Int      @default(0)
  updatedAt DateTime @updatedAt

  history StudentSkillHistory[]

  @@unique([userId, skillId])
  @@index([userId])
  @@index([userId, skillId])
  @@index([level])
}

