// ── AI Provider ──
model AIProvider {
  id              String    @id @default(cuid())
  name            String    @unique // e.g. "OpenAI", "Anthropic", "Google"
  slug            String    @unique // e.g. "openai", "anthropic", "google"
  type            String    @default("llm") // llm, image, embedding, tts, stt
  apiKey          String? // encrypted at rest
  apiEndpoint     String? // custom endpoint URL
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)
  priority        Int       @default(0) // higher = preferred
  config          String    @default("{}") // JSON: provider-specific config
  monthlyBudget   Float? // per-provider budget cap
  healthStatus    String    @default("unknown") // unknown, healthy, degraded, down
  lastHealthCheck DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  models    AIModel[]
  usageLogs AIUsageLog[]
}

// ── AI Model ──
model AIModel {
  id         String  @id @default(cuid())
  providerId String
  name       String // e.g. "GPT-4o", "Claude 3.5 Sonnet"
  slug       String // e.g. "gpt-4o", "claude-3.5-sonnet"
  modelId    String // API model identifier e.g. "gpt-4o-2024-08-06"
  type       String  @default("chat") // chat, completion, embedding, image, tts, stt
  isActive   Boolean @default(true)
  isDefault  Boolean @default(false)

  // ── Pricing (per 1M tokens) ──
  inputPricePer1M  Float @default(0) // USD per 1M input tokens
  outputPricePer1M Float @default(0) // USD per 1M output tokens

  // ── Capabilities ──
  contextWindow     Int     @default(4096)
  maxOutputTokens   Int     @default(4096)
  supportsVision    Boolean @default(false)
  supportsStreaming Boolean @default(true)
  supportsJson      Boolean @default(true)
  capabilities      String  @default("{}") // JSON: extra capabilities

  // ── Rate Limits ──
  rpmLimit Int? // requests per minute
  tpmLimit Int? // tokens per minute

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider  AIProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  usageLogs AIUsageLog[]

  @@unique([providerId, slug])
}

// ── AI Usage Log ──
model AIUsageLog {
  id         String  @id @default(cuid())
  providerId String
  modelId    String?
  feature    String // tutor, quiz_generator, moderation, etc.
  action     String // chat_completion, embedding_create, image_generate, etc.

  // ── Token Usage ──
  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  // ── Cost ──
  costUSD Float @default(0)

  // ── Performance ──
  latencyMs  Int? // response time in ms
  isStreamed Boolean @default(false)

  // ── Status ──
  status       String  @default("success") // success, error, rate_limited, timeout
  errorMessage String?
  errorCode    String?

  // ── Context ──
  userId    String?
  courseId  String?
  sessionId String? // tutor session ID
  requestId String? // unique request ID
  metadata  String  @default("{}") // JSON: additional context

  createdAt DateTime @default(now())

  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model    AIModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
}

// ── AI Prompt Template ──
model AIPromptTemplate {
  id              String   @id @default(cuid())
