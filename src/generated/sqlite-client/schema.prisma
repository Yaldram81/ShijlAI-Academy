// Event Log - the CRITICAL foundation for the learning intelligence system
model LearningMetric {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  courseId   String? // optional course context
  topicId    String? // topic/module identifier (e.g., course category, module title)
  eventType  String // lesson_completed, quiz_attempted, assignment_submitted, time_spent, course_enrolled, ai_tutor_used, login, video_watched, note_created, bookmark_created
  eventValue Float    @default(0) // score / duration / completion (0-100 for scores, seconds for time)
  metadata   String? // JSON for additional context (quizId, lessonId, etc.)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, eventType])
  @@index([userId, courseId])
  @@index([userId, topicId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Topic Mastery - per student per topic understanding level with weighted formula and decay
// Weighted Formula: Quiz 50% + Assignments 25% + Practice 15% + Completion 10%
// Status: not_started (0-25%), weak (25-50%), learning (50-75%), strong (75-90%), mastered (90-100%)
model TopicMastery {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  topicId   String // topic/module identifier
  topicName String // human-readable topic name
  courseId  String? // optional course reference
  skillId   String? // parent skill this topic contributes to

  // Weighted mastery components (0-100 each)
  quizScore       Float @default(0) // Quiz performance (50% weight)
  assignmentScore Float @default(0) // Assignment performance (25% weight)
  practiceScore   Float @default(0) // Practice quiz results (15% weight)
  completionScore Float @default(0) // Lesson completion (10% weight)

  // Combined weighted mastery
  masteryScore Float  @default(0) // 0-100, computed from weighted formula
  status       String @default("not_started") // not_started, weak, learning, strong, mastered

  // Question tracking
  questionsAttempted Int @default(0) // total questions attempted for this topic
  questionsCorrect   Int @default(0) // total questions correct for this topic

  attemptCount  Int      @default(0)
  lastAttempted DateTime @default(now())
  trend         String   @default("stable") // improving, declining, stable
  decayApplied  Boolean  @default(false) // whether time decay has been applied
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
  @@index([userId, courseId])
  @@index([userId, skillId])
  @@index([masteryScore])
  @@index([status])
}

// Skill Topic Mapping - defines which topics contribute to which skills
// Topics are knowledge, Skills are capabilities
// e.g., Topics: Regression, Classification, Neural Networks → Skill: Machine Learning
model SkillTopicMapping {
  id        String   @id @default(cuid())
  skillId   String // skill identifier (e.g., "machine-learning")
  skillName String // human-readable skill name
  topicId   String // topic identifier that contributes to this skill
  topicName String // human-readable topic name
  courseId  String? // optional course context
  weight    Float    @default(1.0) // contribution weight of this topic to the skill
  category  String   @default("general") // programming, web, data, design, devops, soft-skills, science, math
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skillId, topicId])
  @@index([skillId])
  @@index([topicId])
  @@index([courseId])
  @@index([category])
}

