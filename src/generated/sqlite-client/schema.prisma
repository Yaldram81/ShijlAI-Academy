  countryCode String? // for international methods

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payout {
  id             String    @id @default(cuid())
  instructorId   String
  instructor     User      @relation(fields: [instructorId], references: [id])
  amount         Float
  currency       String    @default("PKR")
  status         String    @default("pending") // pending, processing, completed, failed, cancelled, disputed
  method         String // bank_transfer, jazzcash, easypaisa, payoneer, stripe
  payoutMethodId String?
  reference      String? // external transaction reference
  notes          String?
  periodStart    DateTime? // earning period
  periodEnd      DateTime?
  requestedAt    DateTime  @default(now())
  processedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Dispute fields
  disputeReason     String? // instructor's claim about the payout
  disputeResolution String? // admin's resolution explanation
  disputedAt        DateTime? // when the payout was disputed
  taxWithheld       Float     @default(0) // withholding tax deducted
  grossEarning      Float     @default(0) // gross earning before tax
}

model Conversation {
  id                 String   @id @default(cuid())
  type               String   @default("direct") // direct, group
  courseId           String? // optional course context
  title              String? // for group conversations
  lastMessageAt      DateTime @default(now())
  lastMessageContent String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  role           String       @default("member") // admin, member
  lastReadAt     DateTime?
  isMuted        Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isStarred      Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  type           String       @default("text") // text, image, file, system
  attachments    String? // JSON array of {url, name, type, size}
  isRead         Boolean      @default(false)
  readBy         String? // JSON array of userIds who read the message
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  type         String // enrollment, qa, review, assignment, message, payout, system, promotion, achievement, reminder, security, social, course_update, live_session
  title        String
  content      String
  icon         String? // emoji or icon name
  link         String? // navigation link
  isRead       Boolean   @default(false)
  readAt       DateTime?
  courseId     String? // optional course context
  senderId     String? // who triggered the notification
  metadata     String? // JSON for extra data
  priority     String    @default("normal") // normal, high, urgent
  category     String    @default("general") // general, academic, financial, social, system, security
  actionUrl    String? // URL for primary action button
  actionLabel  String? // Label for action button e.g., "View Course", "Accept"
  dismissUrl   String? // URL for dismiss/secondary action
  dismissLabel String? // Label for dismiss button e.g., "Dismiss", "Later"
  isArchived   Boolean   @default(false)
  archivedAt   DateTime?
  isPinned     Boolean   @default(false)
  pinnedAt     DateTime?
  expiresAt    DateTime? // optional expiry for time-sensitive notifications
  createdAt    DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, isArchived])
  @@index([userId, type])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Channel preferences
  enableInApp                 Boolean  @default(true)
  enableEmail                 Boolean  @default(true)
  enablePush                  Boolean  @default(false)
  // Type-specific preferences
  enrollmentNotifications     Boolean  @default(true)
  courseUpdateNotifications   Boolean  @default(true)
  assignmentNotifications     Boolean  @default(true)
  qaNotifications             Boolean  @default(true)
  reviewNotifications         Boolean  @default(true)
  messageNotifications        Boolean  @default(true)
  payoutNotifications         Boolean  @default(true)
  achievementNotifications    Boolean  @default(true)
  socialNotifications         Boolean  @default(true)
  securityNotifications       Boolean  @default(true)
  promotionNotifications      Boolean  @default(false)
  liveSessionNotifications    Boolean  @default(true)
  reminderNotifications       Boolean  @default(true)
  systemNotifications         Boolean  @default(true)
  // Delivery preferences
  digestMode                  String   @default("instant") // instant, daily, weekly
  quietHoursEnabled           Boolean  @default(false)
  quietHoursStart             String   @default("22:00")
  quietHoursEnd               String   @default("08:00")
  // Sound & display
  soundEnabled                Boolean  @default(true)
  desktopAlerts               Boolean  @default(false)
  // Auto-actions
  autoArchiveReadAfterDays    Int      @default(30) // auto-archive read notifications after N days
  autoDeleteArchivedAfterDays Int      @default(90) // auto-delete archived after N days
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model InstructorProfile {
