// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/custom.db"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  avatar        String?
  role          String   @default("student") // student, instructor, admin, parent
  bio           String?
  language      String   @default("en") // en, ur
  xp            Int      @default(0)
  level         Int      @default(1)
  shijlCoins    Int      @default(0)
  streak        Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Auth fields
  passwordHash        String?
  isVerified          Boolean   @default(false)
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  otpCode             String?
  otpExpiresAt        DateTime?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  loginAttempts       Int       @default(0)
  lockedUntil         DateTime?
  authProvider        String    @default("email") // email, google, facebook, apple
  phone               String?

  // Admin management fields
  status        String    @default("active") // active, suspended, banned, pending_verification
  flaggedReason String? // reason for flagging
  adminNotes    String? // JSON array of {note, adminName, date}
  lastLoginAt   DateTime? // last successful login timestamp
  lastLoginIp   String? // last login IP address

  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
  badges        UserBadge[]
  certificates  Certificate[]
  chatMessages  ChatMessage[]
  tutorSessions TutorSession[]
  parentLinks   ParentLink[]   @relation("ParentChildren")
  parentOf      ParentLink[]   @relation("ParentOf")

  // Instructor specific
  coursesCreated Course[] @relation("InstructorCourses")

  // Q&A
  qaQuestions     QAQuestion[]
  qaAnswers       QAAnswer[]
  qaSettings      QASettings[]
  qaUpvotes       QAUpvote[]
  qaAnswerUpvotes QAAnswerUpvote[]

  // Submissions (student)
  submissions Submission[]

  // Messages
  sentMessages  Message[]                 @relation("SentMessages")
  conversations ConversationParticipant[]

  // Notifications
  notifications Notification[]

  // Instructor profile & settings
  instructorProfile  InstructorProfile?
  instructorSettings InstructorSettings?

  // Payout methods
  payoutMethods PayoutMethod[]

  // Payouts received
  payouts Payout[]

  // Commission override
  commissionOverride CommissionOverride?

  // Live sessions (instructor creates, student attends)
  createdLiveSessions LiveSession[]     @relation("InstructorSessions")
  sessionAttendees    SessionAttendee[]

  // Transactions
  enrollmentTransactions Transaction[] @relation("TransactionStudent")
  instructorTransactions Transaction[] @relation("TransactionInstructor")

  // Wishlist & Reviews
  wishlist Wishlist[]
  reviews  Review[]

  // Notes & Bookmarks
  lessonNotes     LessonNote[]
  lessonBookmarks LessonBookmark[]

  // Skills
  userSkills UserSkill[]

  // Progress & Goals
  learningGoals  LearningGoal[]
  userChallenges UserChallenge[]
  streakFreezes  StreakFreeze[]
  xpActivities   XpActivity[]

  // Gamification Rewards
  userRewards UserReward[]

  // Community
  discussionPosts        DiscussionPost[]
  discussionReplies      DiscussionReply[]
  discussionUpvotes      DiscussionUpvote[]
  studyGroupMemberships  StudyGroupMember[]
  studyGroupsCreated     StudyGroup[]         @relation("CreatedGroups")
  peerReviewsGiven       PeerReview[]         @relation("PeerReviewReviewer")
  peerReviewsReceived    PeerReview[]         @relation("PeerReviewReviewee")
  communityEventsCreated CommunityEvent[]     @relation("CreatedEvents")
  eventAttendances       EventAttendee[]
  groupMessages          StudyGroupMessage[]
  groupResources         StudyGroupResource[]
  discussionBookmarks    DiscussionBookmark[]
  scheduleEvents         ScheduleEvent[]

  // Activity logs (admin audit trail)
  activityLogs ActivityLog[]

  // Notification preferences
  notificationPreference NotificationPreference?

  // Instructor application
  instructorApplication InstructorApplication?

  // Student settings
  studentSettings StudentSettings?

  // User sessions
  sessions UserSession[]

  // AI Tools
  aiGenerations       AIGeneration[]
  aiTemplates         AITemplate[]
  aiAssistantMessages AIAssistantMessage[]

  // Blog
  blogPosts BlogPost[] @relation("BlogPosts")

  // Ask ShijlAI
  learningProfile   StudentLearningProfile?
  shijlAISessions   ShijlAISession[]
  shijlAIMessages   ShijlAIMessage[]
  aiRecommendations AIRecommendation[]
  learningInsights  LearningInsight[]
  aiQuizGenerations AIQuizGeneration[]
  studyPlans        StudyPlan[]
  aiActivities      StudentAIActivity[]
  learningMetrics   LearningMetric[]
  topicMasteries    TopicMastery[]
  learningEvents    LearningEvent[]

  // Instructor Copilot
  aiGeneratedOutlines    AIGeneratedOutline[]
  aiGeneratedLessons     AIGeneratedLesson[]
  aiGeneratedAssignments AIGeneratedAssignment[]
  aiGeneratedRubrics     AIGeneratedRubric[]
  aiGeneratedQuizCopilot AIGeneratedQuiz[]
  instructorAIActivities InstructorAIActivity[]

  // Learning Paths
  learningPaths LearningPath[]

  // AI Companion
  companionMessages AICompanionMessage[]
  companionEvents   AICompanionEvent[]

  // Mock Interviews
  mockInterviews MockInterview[]
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  type        String // course_published, refund_requested, post_flagged, instructor_applied, revenue_received, security_alert, payout_disputed, user_signup, enrollment_created, course_review_pending, user_suspended, user_banned, refund_issued, notification_sent, revenue_split_changed, course_rejected, content_removed, settings_updated, payout_processed, api_key_generated, role_created, ip_blocked, login_alert
  title       String
  description String?
  icon        String   @default("📋") // emoji icon
  metadata    String? // JSON for extra data (courseId, amount, etc.)
  createdAt   DateTime @default(now())

  // Audit log specific fields
  action     String  @default("generic") // The specific action verb: approved, suspended, removed, issued, changed, sent, rejected, created, deleted, updated, processed, generated, blocked
  targetName String? // Display name of the target (e.g., "Django API", "Bilal Raza", "Post #4821")
  targetType String? // Type of target: user, course, post, refund, notification, settings, payout, api_key, role, ip, system
  targetId   String? // ID of the target entity
  ipAddress  String? // IP address of the admin who performed the action
  severity   String  @default("info") // info, warning, critical
  category   String  @default("admin_action") // admin_action, system_event, security, finance, content, user_management
}

model InstructorApplication {
  id               String  @id @default(cuid())
  applicationCode  String  @unique // public tracking code (e.g., INS-2024-ABC123)
  fullName         String
  email            String
  phone            String?
  expertise        String
  experience       String // years or description
  motivation       String // why they want to teach
  linkedinProfile  String?
  portfolioUrl     String?
  sampleLessonDesc String? // description of a sample lesson they'd create
  teachingApproach String? // teaching methodology
  expectedTimeline String? // when they can start creating content
  resumeUrl        String? // uploaded resume/CV URL

  // Status flow: pending → under_review → interview_scheduled → interview_completed → approved → onboarded
  // Can also go to: rejected, more_info_requested, withdrawn, info_provided
  status String @default("pending")
  // pending, under_review, more_info_requested, info_provided, interview_scheduled,
  // interview_completed, approved, onboarded, rejected, withdrawn

  // Review details
  adminNotes        String? // JSON array of {note, adminName, adminId, date}
  reviewedAt        DateTime?
  reviewedBy        String? // admin user id
  rejectionReason   String?
  rejectionFeedback String? // detailed feedback for rejected applicants
  canReapply        Boolean   @default(true)
  reapplyAfter      DateTime? // cooldown period before reapplication

  // Scoring / evaluation
  evaluationScore    Float? // 0-100 composite score
  evaluationCriteria String? // JSON: {expertise: 80, experience: 70, motivation: 90, ...}
  evaluationNotes    String?

  // Email tracking
  confirmationEmailSent   Boolean   @default(false)
  confirmationEmailSentAt DateTime?
  reviewEmailSent         Boolean   @default(false)
  interviewEmailSent      Boolean   @default(false)
  decisionEmailSent       Boolean   @default(false)
  onboardingEmailSent     Boolean   @default(false)

  // Info request tracking
  infoRequestMessage String? // what info the admin requested
  infoProvidedAt     DateTime? // when applicant provided the info
  infoProvidedData   String? // JSON: the additional data provided

  // Onboarding
  onboardedAt         DateTime?
  onboardingChecklist String? // JSON: {profileCompleted: true, firstCourseStarted: false, ...}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When approved, link to created user
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Timeline events
  timeline   ApplicationTimeline[]
  // Interviews
  interviews ApplicationInterview[]
}

// Application timeline - tracks every status change and event
model ApplicationTimeline {
  id              String                @id @default(cuid())
  applicationId   String
  application     InstructorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event           String // status_change, note_added, email_sent, interview_scheduled, etc.
  fromStatus      String?
  toStatus        String?
  title           String
  description     String?
  performedBy     String? // admin user id or 'system' or 'applicant'
  performedByName String? // display name
  metadata        String? // JSON for additional data
  createdAt       DateTime              @default(now())

  @@index([applicationId])
}

// Interview scheduling
model ApplicationInterview {
  id              String                @id @default(cuid())
  applicationId   String
  application     InstructorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewType   String                @default("video_call") // video_call, phone, in_person
  scheduledAt     DateTime
  duration        Int                   @default(30) // minutes
  meetingUrl      String? // Zoom/Google Meet link
  meetingId       String? // external meeting ID
  meetingPassword String?
  location        String? // for in-person interviews
  status          String                @default("scheduled") // scheduled, confirmed, completed, cancelled, rescheduled, no_show
  interviewerId   String? // admin user id
  interviewerName String? // admin display name
  notes           String? // pre-interview notes
  feedback        String? // post-interview feedback (JSON: {strengths, concerns, recommendation, score})
  feedbackScore   Float? // 0-100 interview score
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([applicationId])
}

model Course {
  id                  String   @id @default(cuid())
  title               String
  description         String
  category            String // e.g., "FSc", "O-Levels", "A-Levels", "AWS", "IELTS"
  level               String   @default("beginner") // beginner, intermediate, advanced
  language            String   @default("en")
  thumbnail           String?
  price               Float    @default(0)
  isPublished         Boolean  @default(false)
  isArchived          Boolean  @default(false)
  enrollmentCount     Int      @default(0)
  rating              Float    @default(0)
  learningObjectives  String? // JSON array of strings
  prerequisites       String? // JSON array of strings
  targetAudience      String? // description of target audience
  tags                String? // JSON array of tag strings
  estimatedDuration   Int      @default(0) // total hours
  certificateEnabled  Boolean  @default(true)
  completionThreshold Float    @default(80) // % needed to complete
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id])

  // Admin management fields
  reviewStatus         String    @default("draft") // draft, under_review, approved, rejected, changes_requested, flagged
  reviewNote           String? // admin note sent to instructor during review
  reviewChecklist      String? // JSON object of checklist items with pass/fail/warn status
  featured             Boolean   @default(false) // shows in homepage banner
  staffPick            Boolean   @default(false) // marked as staff pick
  overridePrice        Float? // promotional override price (null = no override)
  overridePriceUntil   DateTime? // when the promo price expires
  ageRestriction       String    @default("none") // none, 13+, 18+
  regionRestricted     Boolean   @default(false) // if true, restricted to Pakistan only
  flaggedReason        String? // reason for flagging
  adminNotes           String? // JSON array of {note, adminName, date}
  submittedForReviewAt DateTime? // when instructor submitted for review
  reviewedAt           DateTime? // when admin last reviewed
  reviewedBy           String? // admin userId who reviewed
  promoVideoUrl        String? // promo video URL

  modules      Module[]
  enrollments  Enrollment[]
  quizzes      Quiz[]
  assignments  Assignment[]
  qaQuestions  QAQuestion[]
  transactions Transaction[]
  liveSessions LiveSession[]
  wishlists    Wishlist[]
  reviews      Review[]

  // Community
  discussionPosts DiscussionPost[]
  studyGroups     StudyGroup[]
  communityEvents CommunityEvent[]

  // Schedule
  scheduleEvents ScheduleEvent[]

  // AI Tools
  aiGenerations AIGeneration[]

  // Instructor Copilot
  aiGeneratedOutlines    AIGeneratedOutline[]
  aiGeneratedLessons     AIGeneratedLesson[]
  aiGeneratedAssignments AIGeneratedAssignment[]
  aiGeneratedRubrics     AIGeneratedRubric[]
  aiGeneratedQuizCopilot AIGeneratedQuiz[]

  // Review History
  reviewHistory CourseReviewHistory[]

  // Smart Assessment
  learningOutcomes LearningOutcome[]

  // Skills
  courseSkills CourseSkill[]

  // Quality Analysis
  qualityAnalysis CourseQualityAnalysis?
}

model Module {
  id                 String  @id @default(cuid())
  title              String
  description        String?
  order              Int     @default(0)
  courseId           String
  course             Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningObjectives String? // JSON array of strings for module-level objectives
  isPublished        Boolean @default(false) // module-level publish control

  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  content     String // markdown content
  type        String  @default("video") // video, text, interactive, quiz, assignment, live-session, download
  videoUrl    String?
  duration    Int     @default(0) // in minutes
  order       Int     @default(0)
  moduleId    String
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   String? // JSON array of {title, url, type} for downloadable resources
  objectives  String? // JSON array of strings - what students will learn
  isFree      Boolean @default(false) // free preview lesson
  isPublished Boolean @default(true) // lesson-level publish control
  transcript  String? // video transcript text
  slideUrl    String? // presentation slides URL

  progress     LessonProgress[]
  qaQuestions  QAQuestion[]
  notes        LessonNote[]
  bookmarks    LessonBookmark[]
  lessonSkills LessonSkill[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Enrollment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id])
  progress     Float     @default(0) // percentage 0-100
  status       String    @default("active") // active, completed, archived
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
  lastAccessed DateTime  @default(now())

  lessonProgress LessonProgress[]
  review         Review?
  notes          LessonNote[]
  bookmarks      LessonBookmark[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  status       String     @default("not_started") // not_started, in_progress, completed
  timeSpent    Int        @default(0) // in seconds
  completedAt  DateTime?
  xpEarned     Int        @default(0)

  @@unique([enrollmentId, lessonId])
}

model Quiz {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String   @default("practice") // practice, assessment, diagnostic, certification
  timeLimit    Int      @default(0) // in minutes, 0 = no limit
  passingScore Float    @default(70)
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  moduleId     String? // optional: quiz belongs to a specific module
  maxAttempts  Int      @default(0) // 0 = unlimited
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions Question[]
  attempts  QuizAttempt[]
}

model Assignment {
  id             String    @id @default(cuid())
  title          String
  description    String
  instructions   String // detailed instructions (markdown)
  type           String    @default("written") // written, coding, project, peer-review, presentation
  moduleId       String? // optional: belongs to a specific module
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  maxScore       Int       @default(100)
  dueDate        DateTime?
  rubric         String? // JSON array of {criteria, description, maxPoints}
  resources      String? // JSON array of {title, url, type} for reference materials
  submissionType String    @default("text") // text, file, url, multiple
  wordLimit      Int? // for written assignments
  isPublished    Boolean   @default(true)
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submissions        Submission[]
  peerReviews        PeerReview[]
  aiGeneratedRubrics AIGeneratedRubric[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text          String
  type          String   @default("mcq") // mcq, true_false, fill_blank, short_answer
  options       String // JSON string for MCQ options
  correctAnswer String
  explanation   String?
  points        Int      @default(1)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  questionSkills QuestionSkill[]
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  score       Float     @default(0)
  maxScore    Float     @default(0)
  percentage  Float     @default(0)
  passed      Boolean   @default(false)
  answers     String // JSON string of user answers
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  xpEarned    Int       @default(0)
}

model Badge {
  id          String  @id @default(cuid())
  name        String
  description String
  icon        String // emoji or icon name
  category    String // learning, streak, social, achievement
  xpReward    Int     @default(0)
  coinReward  Int     @default(0)
  requirement String // JSON string describing unlock criteria
  isActive    Boolean @default(true) // admin toggle to enable/disable badge

  userBadges    UserBadge[]
  streakRewards StreakReward[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  courseId         String
  courseTitle      String
  userName         String
  instructorName   String? // instructor who issued the course
  score            Float
  issuedAt         DateTime @default(now())
  certificateId    String   @unique // unique verification code like SHIJL-GIT-20241230-SA
  verificationHash String? // simulated blockchain hash for verification
  templateType     String   @default("completion") // completion, excellence, distinction
}

model TutorSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String // auto-generated from first message topic
  context    String? // course/lesson context
  language   String   @default("en") // en, ur
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  sessionId   String?
  session     TutorSession? @relation(fields: [sessionId], references: [id])
  role        String // user, assistant
  content     String
  context     String? // course/lesson context
  language    String        @default("en") // en, ur
  quickAction String? // explain_simpler, more_examples, test_me, translate
  createdAt   DateTime      @default(now())
}

model ParentLink {
  id       String @id @default(cuid())
  parentId String
  parent   User   @relation("ParentOf", fields: [parentId], references: [id])
  childId  String
  child    User   @relation("ParentChildren", fields: [childId], references: [id])

  @@unique([parentId, childId])
}

model DailyActivity {
  id               String   @id @default(cuid())
  userId           String
  date             String // YYYY-MM-DD format
  xpEarned         Int      @default(0)
  lessonsCompleted Int      @default(0)
  quizzesTaken     Int      @default(0)
  timeSpent        Int      @default(0) // in seconds
  createdAt        DateTime @default(now())

  @@unique([userId, date])
}

model PlatformStats {
  id                String   @id @default(cuid())
  totalUsers        Int      @default(0)
  totalCourses      Int      @default(0)
  totalEnrollments  Int      @default(0)
  totalCertificates Int      @default(0)
  activeUsers       Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model QAQuestion {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  lessonId      String?
  lesson        Lesson?  @relation(fields: [lessonId], references: [id])
  question      String
  isAnswered    Boolean  @default(false)
  isPinned      Boolean  @default(false)
  isFlagged     Boolean  @default(false) // flagged as not a question
  upvotes       Int      @default(0)
  aiDraftAnswer String? // AI-generated draft answer
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Moderation fields
  flaggedReason    String? // reason for flagging
  flagCount        Int       @default(0) // number of user flags
  aiAssessment     String? // AI-generated moderation assessment
  moderationStatus String    @default("none") // none, under_review, removed, kept, escalated
  moderatedAt      DateTime? // when admin last moderated
  moderatedBy      String? // admin userId who moderated

  answers       QAAnswer[]
  upvoteRecords QAUpvote[]
}

model QAAnswer {
  id                 String     @id @default(cuid())
  questionId         String
  question           QAQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId             String
  user               User       @relation(fields: [userId], references: [id])
  content            String
  isAiGenerated      Boolean    @default(false)
  isInstructorAnswer Boolean    @default(false) // true if posted by instructor
  isEdited           Boolean    @default(false)
  isAccepted         Boolean    @default(false) // accepted answer
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Moderation fields
  isFlagged        Boolean   @default(false)
  flaggedReason    String?
  flagCount        Int       @default(0)
  aiAssessment     String?
  moderationStatus String    @default("none") // none, under_review, removed, kept, escalated
  moderatedAt      DateTime?
  moderatedBy      String?

  upvotes QAAnswerUpvote[]
}

model QAUpvote {
  id         String     @id @default(cuid())
  questionId String
  question   QAQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  createdAt  DateTime   @default(now())

  @@unique([questionId, userId])
}

model QAAnswerUpvote {
  id        String   @id @default(cuid())
  answerId  String
  answer    QAAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([answerId, userId])
}

model QASettings {
  id                  String   @id @default(cuid())
  instructorId        String
  instructor          User     @relation(fields: [instructorId], references: [id])
  autoAnswer          Boolean  @default(false) // AI auto-answers, instructor reviews
  emailNotifications  String   @default("immediately") // immediately, daily, off
  allowStudentReplies Boolean  @default(true)
  requireApproval     Boolean  @default(false) // questions require instructor approval
  maxQuestionsPerDay  Int      @default(10) // per student per course
  updatedAt           DateTime @updatedAt

  @@unique([instructorId])
}

// ==================== NEW MODELS ====================

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id])
  content      String // submission content (text, URL, or file path)
  fileUrls     String? // JSON array of uploaded file URLs
  status       String     @default("submitted") // submitted, grading, graded, returned, resubmitted
  score        Float? // final score
  feedback     String? // instructor feedback (markdown)
  rubricScores String? // JSON object of {criteriaId: score}
  aiPreGrade   String? // JSON: AI pre-grading analysis
  aiFeedback   String? // AI-generated feedback
  submittedAt  DateTime   @default(now())
  gradedAt     DateTime?
  gradedBy     String? // instructor userId who graded
  timeSpent    Int        @default(0) // minutes spent
  attempt      Int        @default(1) // resubmission attempt number
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Transaction {
  id                String    @id @default(cuid())
  type              String // enrollment, refund, payout, adjustment
  amount            Float
  currency          String    @default("PKR")
  status            String    @default("completed") // pending, completed, failed, refunded
  description       String?
  courseId          String?
  course            Course?   @relation(fields: [courseId], references: [id])
  studentId         String? // for enrollment transactions
  student           User?     @relation("TransactionStudent", fields: [studentId], references: [id])
  instructorId      String?
  instructor        User?     @relation("TransactionInstructor", fields: [instructorId], references: [id])
  payoutId          String? // linked payout if applicable
  metadata          String? // JSON for additional data
  paymentMethod     String    @default("credit_debit_card") // credit_debit_card, jazzcash, easypaisa, bank_transfer, payoneer_stripe
  platformFee       Float     @default(0) // 20% platform commission
  instructorEarning Float     @default(0) // 80% instructor earning
  invoiceNumber     String? // unique invoice reference
  refundedAt        DateTime? // when refund was processed
  refundReason      String? // reason for refund
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  disputes Dispute[]
}

model PayoutMethod {
  id           String  @id @default(cuid())
  instructorId String
  instructor   User    @relation(fields: [instructorId], references: [id])
  type         String // bank_transfer, jazzcash, easypaisa, payoneer, stripe
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  // Bank transfer fields
  bankName      String?
  accountNumber String?
  accountHolder String?
  branchCode    String?

  // Mobile wallet fields
  phoneNumber String?
  accountName String?

  // International fields
