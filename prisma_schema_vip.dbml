// Curated Core (VIP) Database Structure for ShijlAI Academy

Table users {
  id varchar [primary key]
  email varchar [unique]
  name varchar
  role varchar [default: "student"]
  xp integer [default: 0]
  level integer [default: 1]
  streak integer [default: 0]
  status varchar [default: "active"]
  created_at timestamp
  updated_at timestamp
}

Table courses {
  id varchar [primary key]
  title varchar
  description text
  category varchar
  level varchar [default: "beginner"]
  price decimal
  is_published boolean [default: false]
  enrollment_count integer [default: 0]
  rating double [default: 0]
  instructor_id varchar
  review_status varchar [default: "draft"]
  created_at timestamp
  updated_at timestamp
}

Table modules {
  id varchar [primary key]
  title varchar
  description text
  order integer [default: 0]
  course_id varchar
  created_at timestamp
  updated_at timestamp
}

Table lessons {
  id varchar [primary key]
  title varchar
  description text
  content text
  type varchar [default: "video"]
  duration integer [default: 0]
  order integer [default: 0]
  module_id varchar
  created_at timestamp
  updated_at timestamp
}

Table enrollments {
  id varchar [primary key]
  user_id varchar
  course_id varchar
  progress double [default: 0]
  status varchar [default: "active"]
  enrolled_at timestamp
  completed_at timestamp
}

Table lesson_progress {
  id varchar [primary key]
  enrollment_id varchar
  lesson_id varchar
  status varchar [default: "not_started"]
  time_spent integer [default: 0]
  completed_at timestamp
}

Table quizzes {
  id varchar [primary key]
  title varchar
  description text
  type varchar [default: "practice"]
  time_limit integer [default: 0]
  passing_score double [default: 70]
  course_id varchar
  is_published boolean [default: true]
}

Table questions {
  id varchar [primary key]
  quiz_id varchar
  text varchar
  type varchar [default: "mcq"]
  options text
  correct_answer varchar
  points integer [default: 1]
}

Table quiz_attempts {
  id varchar [primary key]
  user_id varchar
  quiz_id varchar
  score double [default: 0]
  max_score double [default: 0]
  percentage double [default: 0]
  passed boolean [default: false]
  started_at timestamp
  completed_at timestamp
}

Table assignments {
  id varchar [primary key]
  title varchar
  description text
  instructions text
  course_id varchar
  max_score integer [default: 100]
  due_date timestamp
}

Table submissions {
  id varchar [primary key]
  assignment_id varchar
  student_id varchar
  content text
  status varchar [default: "submitted"]
  score double
  feedback varchar
  submitted_at timestamp
}

Table qa_questions {
  id varchar [primary key]
  user_id varchar
  course_id varchar
  lesson_id varchar
  question varchar
  is_answered boolean [default: false]
  created_at timestamp
}

Table qa_answers {
  id varchar [primary key]
  question_id varchar
  user_id varchar
  content text
  is_ai_generated boolean [default: false]
  is_instructor_answer boolean [default: false]
  created_at timestamp
}

Ref course_instructor: courses.instructor_id > users.id
Ref module_course: modules.course_id > courses.id
Ref lesson_module: lessons.module_id > modules.id
Ref enrollment_user: enrollments.user_id > users.id
Ref enrollment_course: enrollments.course_id > courses.id
Ref progress_enrollment: lesson_progress.enrollment_id > enrollments.id
Ref progress_lesson: lesson_progress.lesson_id > lessons.id
Ref quiz_course: quizzes.course_id > courses.id
Ref question_quiz: questions.quiz_id > quizzes.id
Ref attempt_user: quiz_attempts.user_id > users.id
Ref attempt_quiz: quiz_attempts.quiz_id > quizzes.id
Ref assignment_course: assignments.course_id > courses.id
Ref submission_assignment: submissions.assignment_id > assignments.id
Ref submission_student: submissions.student_id > users.id
Ref qa_question_user: qa_questions.user_id > users.id
Ref qa_question_course: qa_questions.course_id > courses.id
Ref qa_question_lesson: qa_questions.lesson_id > lessons.id
Ref qa_answer_question: qa_answers.question_id > qa_questions.id
Ref qa_answer_user: qa_answers.user_id > users.id

